# =============================================================================
# BrandForge AI — Variables d'environnement (exemple, SANS valeurs réelles).
# Copier ce fichier en `.env` et renseigner les valeurs.
# Les secrets ne sont chargés que dans packages/infrastructure (CODING_STANDARDS.md §9).
# =============================================================================

# --- Base de données (PostgreSQL + Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/brandforge?schema=public"

# --- Fournisseur IA (Groq) ---
# Abstrait derrière le port IAiProvider — permet de changer de fournisseur (ARCHITECTURE.md §10).
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"   # Modèle par défaut, surchargeable sans toucher au code
GROQ_BASE_URL="https://api.groq.com/openai/v1"
AI_PROVIDER_TIMEOUT_MS="30000"        # Timeout par défaut appel IA (CODING_STANDARDS.md §6)
AI_PROVIDER_MAX_RETRIES="3"           # Tentatives sur erreur retryable (backoff 1s, 3s, 9s)

# --- Shopify (Admin API) ---
# Depuis la suppression des tokens statiques (2026), une application du Dev Dashboard
# n'expose plus de SHOPIFY_ADMIN_API_TOKEN fixe : le token est obtenu à la demande par le
# flux OAuth « client credentials grant » et expire (~24 h). Cf. docs/DECISIONS/0005.
SHOPIFY_STORE_DOMAIN=""               # ex. ma-boutique.myshopify.com
SHOPIFY_CLIENT_ID=""                  # Dev Dashboard > votre app > Client ID
SHOPIFY_CLIENT_SECRET=""              # Dev Dashboard > votre app > Client secret
SHOPIFY_API_VERSION="2025-01"
# Archive ZIP publique servant de thème de base. Vide : le thème déjà publié
# sur la boutique est réutilisé (cf. docs/DECISIONS/0006).
SHOPIFY_BASE_THEME_URL=""
SHOPIFY_TIMEOUT_MS="15000"            # Timeout appels Shopify (CODING_STANDARDS.md §6)

# Storefront API : jeton distinct, non couvert par le client credentials grant.
# À renseigner uniquement si la boutique publique est interrogée côté serveur.
SHOPIFY_STOREFRONT_API_TOKEN=""

# --- Extension Chrome (import AliExpress) ---
# Seule route HTTP publique du MVP (API.md §11) : token d'API associé au User.
EXTENSION_API_TOKEN=""

# --- Application web (Next.js) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Authentification (mono/multi-utilisateur basique — PRD.md §6 MVP) ---
AUTH_SECRET=""
